{
  "name": "zipazum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:shared": "pnpm --filter @zipazum/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @zipazum/shared --filter @zipazum/api --filter @zipazum/web --filter @zipazum/ops dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @zipazum/api db:migrate",
    "pipeline:collect": "pnpm --filter @zipazum/api pipeline:collect",
    "pipeline:geocode": "pnpm --filter @zipazum/api pipeline:geocode",
    "pipeline:anchors": "pnpm --filter @zipazum/api pipeline:anchors",
    "pipeline:transit-sample": "pnpm --filter @zipazum/api pipeline:transit-sample",
    "pipeline:stations": "pnpm --filter @zipazum/api pipeline:stations",
    "pipeline:zones": "pnpm --filter @zipazum/api pipeline:zones",
    "deploy:api": "node scripts/deploy-api.mjs",
    "mobile:sync": "pnpm --filter @zipazum/mobile sync",
    "mobile:android": "pnpm --filter @zipazum/mobile android",
    "mobile:ios": "pnpm --filter @zipazum/mobile ios",
    "dev:ops": "pnpm --filter @zipazum/ops dev"
  }
}
