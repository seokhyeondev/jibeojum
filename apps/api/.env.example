# PostgreSQL 연결 문자열. 실제 값은 .env.local에만 둔다 (git 제외)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/zipazum?schema=zipazum&sslmode=require
# 이 앱의 테이블이 들어가는 스키마. 공용 DB라 이 스키마 밖은 건드리지 않는다
DATABASE_SCHEMA=zipazum
# API 서버 인스턴스당 최대 DB 연결 수
DATABASE_POOL_MAX=5
# Nest가 듣는 포트
PORT=4000

# 공공데이터포털(data.go.kr) 인증키 (일반 인증키 Decoding/Encoding 중 아무거나). 국토부 전월세 실거래 4종에 활용신청 필요
DATA_GO_KR_SERVICE_KEY=
# 브이월드 오픈API 인증키 (지오코더). 기본 좌표 변환 제공자
VWORLD_API_KEY=
# 네이버 클라우드 Maps (선택). Geocoding: 브이월드가 실패한 주소 보조 + 출근지 주소 검색
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 네이버 API HUB 검색 (선택). 출근지 회사·빌딩·업체명 검색(지역 검색). Maps와 다른 키
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# SK open API TMAP 대중교통. 비우면 외부 호출 없이 mock 제공자를 쓴다
TMAP_APP_KEY=
TMAP_TRANSIT_API_URL=https://apis.openapi.sk.com/transit/routes/sub

# 디버그 API(/api/debug/*) 열기. 운영에서는 false 또는 DEBUG_TOKEN과 함께 사용
DEBUG_TOOLS=false
# 값이 있으면 x-debug-token 헤더가 같아야 디버그 API를 쓸 수 있다
DEBUG_TOKEN=
# 요청 제출 시 추천 동네를 백그라운드로 계산할지 (TMAP 호출이 요청당 약 30회 발생)
AREA_RECOMMENDATIONS_ON_SUBMIT=true

# 내부 운영 웹(/admin) 로그인 비밀번호. 비우면 운영 웹 로그인이 막힌다
ADMIN_PASSWORD=
# 운영자·중개사 세션 쿠키 서명 키 (긴 임의 문자열). 비우면 서버를 켤 때마다 바뀐다
AUTH_SECRET=

# 사진 저장소: S3(비공개) + CloudFront. 로컬은 AWS_PROFILE, 서버(ECS)는 태스크 역할을 쓴다
AWS_PROFILE=
S3_BUCKET=
S3_REGION=ap-northeast-2
ASSET_BASE_URL=https://xxxx.cloudfront.net

# 카카오 로그인 (developers.kakao.com → 내 애플리케이션)
# REST API 키, [카카오 로그인] 활성화, Redirect URI에 아래 주소 등록. 보안 탭에서 Client Secret을 켰으면 그 값도 넣는다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 앞단 프록시 수. req.ip를 사용자 IP로 맞춘다 (로컬: Next 1, 배포: Vercel·CloudFront·ALB 3)
TRUST_PROXY_HOPS=1

# 공인중개사 초대 링크에 쓰는 웹 주소
WEB_ORIGIN=http://localhost:3000
